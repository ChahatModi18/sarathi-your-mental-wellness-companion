# =======================================================
# Git Ignore Configuration — Sarathi Mental Wellness Platform
# Ensures no sensitive credentials, secrets, or large blobs are committed
# =======================================================

# --- Environment & Sensitive Credentials ---
.env
.env.*
!.env.example
*.pem
*.key
*.cert
*.crt
secrets/
credentials/
*.pfx
*.p12

# --- Python Virtual Environments ---
.venv/
venv/
ENV/
env/
Scripts/
Lib/
Include/
pyvenv.cfg
bin/
lib/
include/

# --- Python Bytecode & Build Artifacts ---
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
*.egg-info/
dist/
build/
*.egg
eggs/
.eggs/

# --- Temporary & Database Dumps ---
*.db
*.sqlite
*.sqlite3
*.log
*.sql.gz
*.bak
*.tmp
*.temp

# --- Testing & Code Quality Caches ---
.cache/
.pytest_cache/
.mypy_cache/
.coverage
htmlcov/
.tox/

# --- Operating System & IDE Files ---
.DS_Store
Thumbs.db
desktop.ini
.vscode/
.idea/
*.swp
*.swo
*~

# --- Deployment & Cloud Artifacts ---
.vercel/
node_modules/
.serverless/

# --- External & Unrelated Local Dirs ---
food_ordering_platform/
archive/
share/
todo_*.json

# --- Large Binary Model Checkpoints (Use JSON matrices) ---
*.pth
*.pt
*.bin
*.onnx
*.h5
*.keras

.vercel

# Desktop GUI artifacts
gui_desktop/
desktop_app/
requirements-desktop.txt
